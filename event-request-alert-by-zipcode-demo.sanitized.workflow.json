    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(item => item.json);\n\nconst clean = value => String(value || '').trim().toLowerCase();\n\nconst cleanZip = value => {\n  return String(value || '')\n    .trim()\n    .replace(/\\D/g, '')\n    .slice(0, 5);\n};\n\nconst latest = rows[rows.length - 1];\n\nconst latestZip = cleanZip(latest.zip);\nconst latestZipCluster = latestZip.slice(0, 3);\n\nconst zipClusterLookup = {\n  '908': 'Long Beach area',\n  '900': 'Los Angeles area',\n  '902': 'West LA / Santa Monica area',\n  '941': 'San Francisco area',\n  '946': 'Oakland area',\n  '921': 'San Diego area',\n  '787': 'Austin area',\n  '100': 'New York City area',\n};\n\nconst locationLabel = zipClusterLookup[latestZipCluster] || `ZIP cluster ${latestZipCluster}xx`;\n\nconst uniqueMap = new Map();\n\nfor (const row of rows) {\n  const email = clean(row.email);\n  const zip = cleanZip(row.zip);\n\n  if (!email || !zip) continue;\n\n  const key = `${email}_${zip}`;\n  uniqueMap.set(key, {\n    email,\n    zip,\n    zip_cluster: zip.slice(0, 3),\n    event_type: row.event_type || '',\n    topic: row.topic || '',\n  });\n}\n\nconst uniqueRequests = Array.from(uniqueMap.values());\n\nconst matchingRequests = uniqueRequests.filter(request => {\n  return request.zip_cluster === latestZipCluster;\n});\n\nconst eventTypeCounts = {};\n\nfor (const request of matchingRequests) {\n  const eventType = request.event_type || 'Not specified';\n  eventTypeCounts[eventType] = (eventTypeCounts[eventType] || 0) + 1;\n}\n\nconst topEventType = Object.entries(eventTypeCounts)\n  .sort((a, b) => b[1] - a[1])[0]?.[0] || 'Not specified';\n\nreturn [\n  {\n    json: {\n      latest_zip: latestZip,\n      zip_cluster: `${latestZipCluster}xx`,\n      location_label: locationLabel,\n      request_count: matchingRequests.length,\n      top_event_type: topEventType,\n      threshold_met: matchingRequests.length >= 5,\n      slack_message: `\ud83d\udea8 Event Request Alert by ZIP Code\n\n${matchingRequests.length} unique people have requested an n8n event near ${locationLabel} (${latestZipCluster}xx).\n\nMost requested event type: ${topEventType}`\n    }\n  }\n];"
      },
